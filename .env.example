# ============================================
# Конференции.РФ — конфигурация (JWT-версия)
# ============================================
# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env
# ============================================

# ---- База данных MySQL ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=conferences_db

# ---- JWT ----
# Секреты для подписи токенов. ДОЛЖНЫ быть разными!
# Минимум 32 символа. Сгенерировать оба:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Access-токен — короткоживущий, передаётся в заголовке Authorization: Bearer ...
JWT_SECRET=change_me_to_very_long_random_string_at_least_32_chars

# Refresh-токен — долгоживущий, хранится в httpOnly cookie
JWT_REFRESH_SECRET=another_very_long_random_string_at_least_32_chars

# Время жизни токенов (формат из jsonwebtoken: 15m, 1h, 7d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Сервер ----
PORT=3000
NODE_ENV=development

# ---- Cookie (для refresh-токена) ----
# secure=true требует HTTPS. На localhost должно быть false.
COOKIE_SECURE=false
